# ---------------------------------------------------------------------------
# BAZA DANYCH
# Connection string do PostgreSQL (np. Neon, Supabase, Railway, Vercel Postgres)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/relationship_compass?schema=public"

# ---------------------------------------------------------------------------
# NEXTAUTH
# NEXTAUTH_SECRET wygenerujesz poleceniem: openssl rand -base64 32
# NEXTAUTH_URL to adres, pod którym działa aplikacja (lokalnie lub na Vercel)
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET="wygeneruj-losowy-sekret-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# AI (Google Gemini - darmowe API)
# Klucz NIGDY nie trafia do frontendu - używany wyłącznie w API routes.
# Zdobądź darmowy klucz na: https://aistudio.google.com/apikey
# UWAGA: na darmowym planie Google może wykorzystywać treść zapytań do
# ulepszania swoich produktów - patrz README, sekcja "Konfiguracja AI API".
# ---------------------------------------------------------------------------
GEMINI_API_KEY="AIza..."
GEMINI_MODEL="gemini-2.5-flash"
